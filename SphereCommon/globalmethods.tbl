GLOBALMETHOD(Account,		CSCRIPTPROP_DUPE|CSCRIPTPROP_RETREF|CSCRIPTPROP_NARG1, "FINDACCOUNT")
GLOBALMETHOD(AccountMgr,	CSCRIPTPROP_RETREF|CSCRIPTPROP_NARGS, "ref Account manager")
GLOBALMETHOD(FindAccount,	CSCRIPTPROP_RETREF|CSCRIPTPROP_NARG1, "ref a particular account name")
GLOBALMETHOD(FindUID,		CSCRIPTPROP_RETREF|CSCRIPTPROP_NARG1, "ref a particular UID")
GLOBALMETHOD(Serv,			CSCRIPTPROP_RETREF|CSCRIPTPROP_NARGS, "ref the main server object")
GLOBALMETHOD(Srv,			CSCRIPTPROP_DUPE|CSCRIPTPROP_RETREF|CSCRIPTPROP_NARGS, "SERV")
//GLOBALMETHOD(UID,			CSCRIPTPROP_DUPE|CSCRIPTPROP_RETREF|CSCRIPTPROP_NARG1, "FINDUID")
GLOBALMETHOD(Var,			CSCRIPTPROP_RETREF|CSCRIPTPROP_ARG1, "get/set a global variable" )
GLOBALMETHOD(Eval,			CSCRIPTPROP_NARG1, "evaluate a numeric expression")
GLOBALMETHOD(Safe,			CSCRIPTPROP_NARG1, "error-safe expression wrapper, returns 0 on failure")
GLOBALMETHOD(StrLen,		CSCRIPTPROP_NARG1, "get string length")
GLOBALMETHOD(StrCmp,		CSCRIPTPROP_NARG1, "compare strings case-sensitive")
GLOBALMETHOD(StrCmpI,		CSCRIPTPROP_NARG1, "compare strings case-insensitive")
GLOBALMETHOD(StrIndexOf,	CSCRIPTPROP_NARG1, "find substring index (-1 if not found)")
GLOBALMETHOD(StrMatch,		CSCRIPTPROP_NARG1, "wildcard pattern match")
GLOBALMETHOD(Rand,			CSCRIPTPROP_NARG1, "random number 0..n-1")
GLOBALMETHOD(QVal,			CSCRIPTPROP_NARG1, "conditional: qval(test,ret_neg,ret_zero,ret_pos)")
GLOBALMETHOD(IsNum,			CSCRIPTPROP_NARG1, "check if string is a number")
